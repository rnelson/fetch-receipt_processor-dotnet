###

GET http://localhost:5284/receipts/{{delete_receipt_guid}}/delete
Accept: application/json

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Response content-type is json", function() {
        let type = response.contentType.mimeType;
        client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
    });
    
    client.test("Delete was successful", function() {
        let deleted = response.body.deleted;
        client.assert(deleted == true, "Receipt '" + client.global.get("delete_receipt_guid") + "' was deleted");
    });
%}

